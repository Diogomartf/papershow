# Copy to .env (in the repo root) and fill in. .env is not committed.

# Groq key for the AI apps (https://console.groq.com/keys). Without it they show stand-in text.
GROQ_API_KEY=
# Optional: any chat model on Groq.
# GROQ_MODEL=openai/gpt-oss-20b

# Massive (formerly Polygon.io) key for the Stocks app (https://massive.com/dashboard).
# Top movers needs the Starter plan or above. Without it the app shows stand-in movers.
MASSIVE_API_KEY=

# logo.dev publishable key (pk_…) for company logos in the Stocks app (https://www.logo.dev).
# Without it, Stocks shows ticker badges.
LOGO_DEV_TOKEN=
