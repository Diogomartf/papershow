# The panel client: follows /live and draws on the e-ink display. install.sh fills in @USER@ and @REPO@.
[Unit]
Description=Papershow panel
After=papershow.service network-online.target
Wants=papershow.service network-online.target

[Service]
User=@USER@
SupplementaryGroups=spi gpio
# lgpio (the Pi 5's GPIO) makes its pipe files in the working directory, which must be writable:
# without one it's /, and the panel fails with "Unable to load any default pin factory".
RuntimeDirectory=papershow-panel
WorkingDirectory=/run/papershow-panel
Environment=PAPERSHOW_URL=http://localhost:@PORT@
# The frame holds the panel upside down.
Environment=PANEL_ROTATE=180
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @REPO@/apps/panel/panel.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
